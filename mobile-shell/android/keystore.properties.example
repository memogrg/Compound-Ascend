# Copy to keystore.properties (gitignored) in this same folder and fill in. Never commit it.
# Absolute path to the upload key .jks, outside the repo; on Windows use forward slashes (C:/Users/<you>/.android-keys/cartera-upload.jks).
storeFile=
# Password of the keystore (.jks) itself.
storePassword=
# Alias of the key inside the keystore (cartera-upload).
keyAlias=
# Password of that key (may be the same as storePassword).
keyPassword=
