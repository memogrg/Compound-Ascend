# ============================================================
# CARTERA+ — variables de entorno (EJEMPLO, sin secretos)
# Copia a .env.local y rellena. NUNCA commitees .env.local.
# Las claves marcadas (BACKEND) jamás deben llevar prefijo NEXT_PUBLIC_.
# ============================================================

# --- Ambiente ---
NODE_ENV=development
APP_ENV=development                       # development | staging | production
NEXT_PUBLIC_APP_URL=http://localhost:3000   # prod: https://cartera.vercel.app

# --- CORS / orígenes permitidos (coma-separados, sin wildcard en prod) ---
ALLOWED_ORIGINS=http://localhost:3000       # prod: https://cartera.vercel.app,http://localhost:3000

# --- Supabase (público: seguro exponer) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (BACKEND: service role — JAMÁS al frontend) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- IA (BACKEND) ---
# OJO: las keys del handoff están comprometidas. Genera nuevas.
AI_PROVIDER=gemini                        # gemini | (futuro: otros)
GEMINI_API_KEY=

# --- Market data (BACKEND) ---
# OJO: estas llaves van en DOS lugares y se cargan por separado — acá/Vercel para el camino en
# vivo de la app, y en Actions (secrets/variables) para el colector horario. Una vencida en un
# solo lado NO se nota mirando el otro. Guía completa: docs/market-data-feed.md
#
# Cadena de proveedores por tipo de activo, en orden (primario, respaldos). Vacío = lo de antes:
# finnhub para acciones/ETF, coingecko para cripto.
MARKET_PROVIDER_STOCKS=                   # ej. massive,finnhub  o  twelvedata,finnhub
MARKET_PROVIDER_CRYPTO=                   # coingecko
MASSIVE_API_KEY=                          # Massive (ex Polygon.io) — Stocks Starter, solo EE. UU.
TWELVEDATA_API_KEY=                       # Twelve Data — EE. UU. + UCITS (VWRA.L → VWRA:LSE)
MARKET_EXCHANGE_SUFFIXES=                 # bolsas extra para Twelve Data, ej. DE=XETR (.L ya es LSE)
FINNHUB_TOKEN=                            # Finnhub free: respaldo de acciones y buscador de símbolos
COINGECKO_API_KEY=                        # opcional: sin ella usa la API pública (con rate limit bajo)
COINGECKO_API_PLAN=                       # "pro" con CUALQUIER plan pago (Basic incluido); vacío = demo
ALPHA_VANTAGE_KEY=
# Yahoo Finance y Binance no requieren key.
#
# Guarda de costo — SOLO la lee el colector (Actions). Créditos/día del plan (mensual ÷ 30):
# MARKET_BUDGET_DAILY_COINGECKO=3300  MARKET_BUDGET_DAILY_TWELVEDATA=  MARKET_BUDGET_WARN_RATIO=0.8

# --- Indicadores económicos (BACKEND) ---
# Costa Rica · BCCR (API SDDE, REST/JSON con Bearer) — https://www.bccr.fi.cr/indicadores-economicos
BCCR_SDDE_TOKEN=                          # token Bearer (JWT) de la suscripción SDDE
BCCR_SDDE_EMAIL=                          # correo de la suscripción (informativo)
# EE. UU. · FRED (Fase 2) — key gratis: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# --- Cache (opcional) ---
REDIS_URL=                                # si vacío, fallback en memoria

# --- Rate-limit distribuido · Upstash Redis (REST) ---
# Requerido en producción (Vercel multi-instancia): sin esto el rate-limit es
# por instancia y se puede evadir escalando lambdas. Crear base en
# https://console.upstash.com → Redis → REST API.
UPSTASH_REDIS_REST_URL=                   # https://<db>.upstash.io
UPSTASH_REDIS_REST_TOKEN=                 # token REST de la base

# --- Observabilidad (opcional, recomendado en prod) ---
# Sentry: captura errores de servidor y navegador. Inerte sin DSN.
NEXT_PUBLIC_SENTRY_DSN=                    # DSN del proyecto Sentry (cliente)
SENTRY_DSN=                               # mismo DSN (server/edge); opcional
# Alertas operativas a Slack (Incoming Webhook). Si falta, solo van al log.
SLACK_ALERT_WEBHOOK_URL=                  # https://hooks.slack.com/services/...

# --- Anti-bot (opcional en dev, requerido en prod) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Pagos / monetización (BACKEND) ---
# Secreto para verificar la firma del webhook de pagos (cambios de plan).
PAYMENT_WEBHOOK_SECRET=

# --- Cron / tareas programadas (BACKEND) ---
# Secreto para autenticar /api/investments/snapshot y /api/indicators/refresh.
# Usar desde Vercel Cron, GitHub Actions o cualquier scheduler externo.
CRON_SECRET=

# ------------------------------------------------------------------
# Ingesta por correo (los avisos del banco que el usuario reenvía)
# ------------------------------------------------------------------
# Buzón que recibe TODO lo reenviado, leído por IMAP. App Password de Google
# (16 caracteres; con o sin espacios), NUNCA la contraseña de la cuenta.
GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_IMAP_USER=
GMAIL_IMAP_APP_PASSWORD=
# Dominio de las direcciones de ingesta ÚNICAS por cuenta (u<token>@dominio).
# Requiere el catch-all de Google Workspace con «Agregar encabezado
# X-Gm-Original-To» activado (docs/ingesta-correo.md §9). Sin esta variable la
# app no reparte direcciones y solo queda el carril heredado con código.
INGEST_ADDRESS_DOMAIN=
# Envío de correo (código de verificación del carril heredado, invitaciones).
# O bien SMTP (recomendado, App Password de Google) o bien Resend.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
EMAIL_FROM=
